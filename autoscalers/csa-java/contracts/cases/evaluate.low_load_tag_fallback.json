{
  "id": "evaluate.low_load_tag_fallback",
  "mode": "evaluate",
  "pythonScript": "autoscalers/csa/scripts/evaluate.py",
  "stdin": {
    "resource": {
      "metadata": {
        "name": "kube-znn",
        "namespace": "default"
      },
      "spec": {
        "replicas": 2
      }
    },
    "metrics": [
      {
        "name": "metric_nginx_req_duration",
        "value": "{\"current_replicas\":2,\"target_value\":\"1000\",\"current_value\":\"850000\"}"
      }
    ]
  },
  "stdout": {
    "strategy": "adapt_tag",
    "parameters": {
      "tag_up": true
    }
  },
  "implicitInput": {
    "config": {
      "enabled_strategies": [
        "adapt_cpu",
        "adapt_tag"
      ],
      "minReplicas": 1,
      "maxReplicas": 5,
      "maxCPU": 1000
    },
    "kubernetesState": {
      "current_mcpu": 500,
      "initial_mcpu": 500
    }
  },
  "notes": "rate=0.85 and CPU cannot be reduced below initial_mcpu, so evaluate falls back to tag_up=true."
}
